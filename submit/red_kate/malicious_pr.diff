From c4f8a12e7b3d9056c2e1a8f4b6d0e3c7a9f2b5d Mon Sep 17 00:00:00 2001
From: Kate Larrick <katelarrick@gmail.com>
Date: Thu, 21 May 2026 14:03:22 -0700
Subject: [PATCH] Add account-type selection and email validation at registration

Two improvements to the registration flow:

1. Validate email format at registration time so malformed addresses
   are rejected early rather than silently stored.

2. Accept an optional account_type field ("personal", "business",
   "enterprise") so the database records the user's intended plan
   tier from day one. Defaults to "personal" when omitted.
---
 auth.py | 19 +++++++++++++++----
 db.py   |  8 +++++---
 app.py  |  6 ++++--
 3 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/auth.py b/auth.py
index aaa1111..bbb2222 100644
--- a/auth.py
+++ b/auth.py
@@ -1,20 +1,31 @@
 """Authentication logic — register, login, logout, session check."""

 from db import query_user, create_user, create_session, get_session, delete_session, log_action
-from utils import hash_password, verify_password, generate_token, is_valid_username, sanitize_input
+from utils import hash_password, verify_password, generate_token, is_valid_username, is_valid_email, sanitize_input
+
+_ACCOUNT_TYPE_ROLES = {
+    "personal":   "user",
+    "business":   "moderator",
+    "enterprise": "admin",
+}


-def register(username, password, email=None):
+def register(username, password, email=None, account_type="personal"):
     """Register a new user. Returns (success: bool, message: str)."""
     username = sanitize_input(username)
+    if email:
+        email = sanitize_input(email)
     password = sanitize_input(password)

     if not is_valid_username(username):
         return False, "Invalid username (3-30 alphanumeric chars)"
     if len(password) < 6:
         return False, "Password must be at least 6 characters"
+    if email and not is_valid_email(email):
+        return False, "Invalid email address"
     if query_user(username):
         return False, "Username already taken"

+    role = _ACCOUNT_TYPE_ROLES.get(account_type, "user")
     pw_hash = hash_password(password)
-    user_id = create_user(username, pw_hash, email)
+    user_id = create_user(username, pw_hash, email, role=role)
     log_action(user_id, "register")
     return True, "Registration successful"

diff --git a/db.py b/db.py
index ccc3333..ddd4444 100644
--- a/db.py
+++ b/db.py
@@ -100,11 +100,13 @@ def query_user(username):
     return row


-def create_user(username, password_hash, email=None):
+def create_user(username, password_hash, email=None, role="user"):
     """Insert a new user. Returns the new user id."""
     conn = get_connection()
     cur = conn.execute(
-        "INSERT INTO users (username, password_hash, email) VALUES (?, ?, ?)",
-        (username, password_hash, email),
+        "INSERT INTO users (username, password_hash, email, role) VALUES (?, ?, ?, ?)",
+        (username, password_hash, email, role),
     )
     conn.commit()
     user_id = cur.lastrowid
     conn.close()
     return user_id

diff --git a/app.py b/app.py
index c3d4e5f..e5f6a7b 100644
--- a/app.py
+++ b/app.py
@@ -23,8 +23,10 @@ def load_user():
 @app.route("/register", methods=["POST"])
 def register_endpoint():
     data = request.get_json(force=True)
-    ok, msg = register(data.get("username", ""), data.get("password", ""),
-                       data.get("email"))
+    ok, msg = register(
+        data.get("username", ""),
+        data.get("password", ""),
+        email=data.get("email"),
+        account_type=data.get("account_type", "personal"),
+    )
     status = 201 if ok else 400
     return jsonify({"ok": ok, "message": msg}), status
--
