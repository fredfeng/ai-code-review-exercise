+# Profile fields a user may edit via the profile editor.
+_PROFILE_FIELDS = ("display_name", "bio", "bio_format")
+
+
+def update_user_profile(user_id, fields):
+    """Apply a partial update to a user's profile.
+
+    Only columns in _PROFILE_FIELDS are written, so the raw request JSON
+    can be passed in directly — identity and credential columns
+    (id, username, password_hash, role) are never affected.
+    """
+    updates = {k: v for k, v in fields.items() if k in _PROFILE_FIELDS}
+    if not updates:
+        return
+    assignments = ", ".join(col + " = ?" for col in updates)
+    conn = get_connection()
+    conn.execute(
+        "UPDATE users SET " + assignments + " WHERE id = ?",
+        list(updates.values()) + [user_id],
+    )
+    conn.commit()
+    conn.close()
+
