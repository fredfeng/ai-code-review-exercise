+def render_bio(user):
+    """Render a user's bio safely for their public profile page.
+
+    To prevent stored XSS, every bio is HTML-escaped by default. Authors
+    who need rich formatting may opt into the 'html' bio format; those
+    bios are first passed through sanitize_input to strip dangerous
+    content, then rendered as markup.
+    """
+    bio = sanitize_input(user["bio"] or "")
+    if user["bio_format"] == "html":
+        return bio
+    return escape(bio)
