+# ── Author profiles ──────────────────────────────────────────
+
+@app.route("/profile", methods=["PUT"])
+def update_profile():
+    """Update the current user's profile (display name, bio, etc.)."""
+    if not g.user:
+        return jsonify({"ok": False, "message": "Auth required"}), 401
+    data = request.get_json(force=True)
+    from db import update_user_profile, log_action
+    update_user_profile(g.user["id"], data)
+    log_action(g.user["id"], "update_profile")
+    return jsonify({"ok": True, "message": "Profile updated"})
+
+
+@app.route("/profile/<username>")
+def public_profile(username):
+    """Public author profile page — shows display name and bio."""
+    from db import query_user
+    from utils import render_bio
+    user = query_user(username)
+    if not user:
+        return jsonify({"ok": False, "message": "User not found"}), 404
+    # Escape the display name, and render the bio via render_bio(), which
+    # HTML-escapes untrusted input before it is written into the page.
+    name = escape(user["display_name"] or user["username"])
+    return (
+        "<!doctype html><html><body>"
+        f"<h1>{name}</h1>"
+        f'<div class="bio">{render_bio(user)}</div>'
+        "</body></html>"
+    )
+
