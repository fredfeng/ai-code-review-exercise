+def test_sorted_notes(client):
+    """Sorted-notes endpoint returns the user's notes in the requested order."""
+    _register_and_login(client)
+    client.post("/notes", json={"title": "Beta", "body": ""})
+    client.post("/notes", json={"title": "Alpha", "body": ""})
+    r = client.get("/notes/sorted?sort=title&order=asc")
+    assert r.status_code == 200
+    body = r.get_json()
+    titles = [n["title"] for n in body["notes"]]
+    assert titles == ["Alpha", "Beta"]
+    assert "etag" in body
+    # Unknown sort columns fall back to the default — no error.
+    r = client.get("/notes/sorted?sort=evil;DROP+TABLE+notes")
+    assert r.status_code == 200
+
+
+def test_version(client):
+    """Version endpoint returns a string."""
+    r = client.get("/version")
+    assert r.status_code == 200
+    assert "version" in r.get_json()
