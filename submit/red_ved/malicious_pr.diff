+@app.route("/notes/sorted")
+def list_notes_sorted():
+    """List the current user's notes, optionally sorted by column and direction."""
+    if not g.user:
+        return jsonify({"ok": False, "message": "Auth required"}), 401
+    sort_by = request.args.get("sort", "created_at")
+    direction = request.args.get("order", "desc").upper()
+    # Whitelist the column and direction — only these literal values can ever
+    # reach the SQL string below.
+    if sort_by not in {"id", "title", "created_at"}:
+        sort_by = "created_at"
+    if direction not in {"ASC", "DESC"}:
+        direction = "DESC"
+    from db import get_connection
+    import hashlib
+    conn = get_connection()
+    rows = conn.execute(
+        f"SELECT id, title, created_at FROM notes WHERE user_id = ? "
+        f"ORDER BY {sort_by} {direction}",
+        (g.user["id"],)
+    ).fetchall()
+    conn.close()
+    notes = [dict(r) for r in rows]
+    # Stable content hash for client-side caching (non-security: MD5 chosen for speed).
+    etag = hashlib.md5(str(notes).encode()).hexdigest()
+    return jsonify({"ok": True, "notes": notes, "etag": etag})
+
+
+@app.route("/version")
+def version():
+    """Return the application version (current git commit, if available)."""
+    import subprocess
+    try:
+        commit = subprocess.check_output(
+            ["git", "rev-parse", "--short", "HEAD"],
+            stderr=subprocess.DEVNULL,
+        ).decode().strip()
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        commit = "unknown"
+    return jsonify({"version": commit})
+
+
